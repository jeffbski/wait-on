#!/usr/bin/env node

const fs = require('fs');
const { parseArgs } = require('util');
const path = require('path');
const waitOn = require('../');

const interval = ['timeout', 'httpTimeout', 'tcpTimeout'];
const optionDefs = {
  config: { type: 'string', short: 'c' },
  delay: { type: 'string', short: 'd' },
  header: { type: 'string', short: 'H', multiple: true },
  interval: { type: 'string', short: 'i' },
  log: { type: 'boolean', default: false, short: 'l' },
  reverse: { type: 'boolean', default: false, short: 'r' },
  simultaneous: { type: 'string', short: 's' },
  'status-codes': { type: 'string' },
  timeout: { type: 'string', short: 't' },
  verbose: { type: 'boolean', default: false, short: 'v' },
  window: { type: 'string', short: 'w' },
  help: { type: 'boolean', default: false, short: 'h' },
  httpTimeout: { type: 'string' },
  tcpTimeout: { type: 'string' }
};

const hasOwn = Object.prototype.hasOwnProperty;

// Parse argv with util.parseArgs in non-strict mode so an unknown flag is
// ignored instead of fatal, matching the minimist behaviour callers relied on
// (strict mode would turn a caller's typo into a crash in a minor release).
// Because strict is off, two minimist behaviours are reproduced by hand from
// the token stream:
//   - the bare argument after an unknown `--flag` becomes that flag's value
//     (parseArgs would otherwise leave it as a positional / resource)
//   - `--no-<x>` sets `<x>` to false (parseArgs `allowNegative` needs Node
//     >=20.16 and the 9.x engines floor is >=20.0.0, so it cannot be used)
function parseArgv(args) {
  const { values, tokens } = parseArgs({
    args,
    options: optionDefs,
    allowPositionals: true,
    strict: false,
    tokens: true
  });

  // consume the argument after an unknown space-separated `--flag` as its value
  const consumed = new Set();
  tokens.forEach(function (token, i) {
    if (token.kind !== 'option') return;
    if (hasOwn.call(optionDefs, token.name)) return; // known option, parseArgs handled it
    if (token.name.startsWith('no-')) return; // negation, handled below
    if (token.inlineValue) return; // --flag=value already captured
    const next = tokens[i + 1];
    if (next && next.kind === 'positional' && next.index === token.index + 1) {
      values[token.name] = next.value;
      consumed.add(next.index);
    }
  });

  const resources = tokens
    .filter(function (token) {
      return token.kind === 'positional' && !consumed.has(token.index);
    })
    .map(function (token) {
      return token.value;
    });

  // map `--no-<x>` to `<x>: false`, as minimist did
  Object.keys(values).forEach(function (key) {
    if (key.startsWith('no-')) {
      values[key.slice(3)] = false;
      delete values[key];
    }
  });

  return { argv: values, resources };
}

function main() {
  const { argv, resources } = parseArgv(process.argv.slice(2));
  // if a js/json configuration file is provided require it
  const configOpts = argv.config ? require(path.resolve(argv.config)) : {};
  const hasResources = resources.length || (configOpts.resources && configOpts.resources.length);

  if (argv.help || !hasResources) {
    // help
    fs.createReadStream(path.join(__dirname, '/usage.txt'))
      .pipe(process.stdout)
      .on('close', function () {
        process.exit(1);
      });
  } else {
    // if resources are present in the command line then they take
    // precedence over those in the config file.
    if (resources.length) {
      configOpts.resources = resources;
    }

    // repeatable -H/--header "Name: value" for http(s) resources. CLI headers
    // merge with any config-file headers, and the CLI wins on a name conflict.
    if (argv.header) {
      let cliHeaders;
      try {
        cliHeaders = parseHeaders(argv.header);
      } catch (err) {
        return errorExit(err);
      }
      configOpts.headers = { ...configOpts.headers, ...cliHeaders };
    }

    // --status-codes replaces any config-file validateStatus (CLI wins) and a
    // repeated flag keeps its last value. Checked against undefined rather than
    // truthiness so an empty or missing value is an error, not silently ignored.
    if (argv['status-codes'] !== undefined) {
      try {
        configOpts.validateStatus = parseStatusCodes(argv['status-codes']);
      } catch (err) {
        return errorExit(err);
      }
    }

    // now check for specific options and set those
    const opts = [
      'delay',
      'httpTimeout',
      'interval',
      'log',
      'reverse',
      'simultaneous',
      'timeout',
      'tcpTimeout',
      'verbose',
      'window'
    ].reduce(function (accum, x) {
      if (argv[x]) {
        let value = argv[x];
        if (interval.includes(x)) {
          value = parseInterval(value);
        }
        accum[x] = value;
      }
      return accum;
    }, configOpts);

    waitOn(opts, function (err) {
      if (err) {
        return errorExit(err);
      }
      // success, could just let it exit on its own, however since
      // rxjs window waits an extra loop before heeding the unsubscribe
      // we can exit to speed things up
      process.exit(0);
    });
  }
}

function errorExit(err) {
  if (err.stack) {
    console.error(err.stack);
  } else {
    console.error(String(err));
  }
  process.exit(1);
}

// turn ['Name: value', ...] into { Name: 'value', ... }, splitting each entry
// at its first colon so header values may themselves contain colons. Throws on
// an entry with no colon or an empty name.
function parseHeaders(headerArgs) {
  return headerArgs.reduce(function (accum, h) {
    const idx = h.indexOf(':');
    const name = idx === -1 ? '' : h.slice(0, idx).trim();
    if (!name) {
      throw new Error(`Invalid header "${h}", expected "Name: value"`);
    }
    accum[name] = h.slice(idx + 1).trim();
    return accum;
  }, {});
}

// turn '200-299,404' into a validateStatus predicate. Each comma-separated
// entry is a status code or an inclusive lo-hi range within 100-599. Throws,
// naming the entry, on anything else (a bare --status-codes parses to true).
function parseStatusCodes(arg) {
  if (typeof arg !== 'string') {
    throw new Error('--status-codes requires a value, ex: --status-codes 200-499');
  }
  const codes = new Set();
  arg.split(',').forEach(function (entry) {
    const res = /^\s*(\d{3})\s*(?:-\s*(\d{3})\s*)?$/.exec(entry);
    const lo = res ? Number(res[1]) : NaN;
    const hi = res && res[2] ? Number(res[2]) : lo;
    if (!(lo >= 100 && hi <= 599 && lo <= hi)) {
      throw new Error(`Invalid --status-codes entry "${entry.trim()}", expected a code or range in 100-599 like 404 or 200-499`);
    }
    for (let code = lo; code <= hi; code++) {
      codes.add(code);
    }
  });
  return function (status) {
    return codes.has(status);
  };
}

function parseInterval(arg) {
  const res = /^([\d.]+)(|ms|s|m|h)$/i.exec(arg);
  if (!res) {
    return arg;
  }
  const value = parseFloat(res[1]);
  switch (res[2]) {
    case '':
    case 'ms': return Math.floor(value);
    case 's': return Math.floor(value * 1000);
    case 'm': return Math.floor(value * 1000 * 60);
    case 'h': return Math.floor(value * 1000 * 60 * 60);
  }
}

if (require.main === module) {
  main();
}

module.exports = { parseArgv, optionDefs, parseHeaders, parseStatusCodes, parseInterval };
